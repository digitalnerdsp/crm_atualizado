# Required
KANEO_CLIENT_URL=https://nortys.example.com
# Optional when using the bundled single-container app; defaults to KANEO_CLIENT_URL/api.
#KANEO_API_URL=https://nortys.example.com/api

# Generated automatically by Coolify magic variables referenced in compose.yml.
# You do not need to add these manually in Coolify:
# SERVICE_HEX_64_AUTH
# SERVICE_PASSWORD_64_POSTGRES

# PostgreSQL
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Lean uploads for Coolify: create/mount a persistent volume at this path.
FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=/app/data/uploads
FILES_MAX_UPLOAD_MB=25

# Optional SMTP, needed for invitations/email login.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
