{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"APPDATA",
		"APP_DESCRIPTION",
		"APP_NAME",
		"AUTH_SECRET",
		"AWS_ACCESS_KEY_ID",
		"AWS_SECRET_ACCESS_KEY",
		"COOKIE_DOMAIN",
		"CORS_ORIGINS",
		"CUSTOM_AUTH_PKCE",
		"CUSTOM_OAUTH_AUTHORIZATION_URL",
		"CUSTOM_OAUTH_AUTO_LOGIN",
		"CUSTOM_OAUTH_CLIENT_ID",
		"CUSTOM_OAUTH_CLIENT_SECRET",
		"CUSTOM_OAUTH_DISCOVERY_URL",
		"CUSTOM_OAUTH_LOGOUT_URL",
		"CUSTOM_OAUTH_RESPONSE_TYPE",
		"CUSTOM_OAUTH_SCOPES",
		"CUSTOM_OAUTH_TOKEN_URL",
		"CUSTOM_OAUTH_USER_INFO_URL",
		"DATABASE_URL",
		"DEMO_MODE",
		"DEVICE_AUTH_CLIENT_IDS",
		"DISABLE_EMAIL_OTP_SIGN_IN",
		"DISABLE_GUEST_ACCESS",
		"DISABLE_LOGIN_FORM",
		"DISABLE_PASSWORD_REGISTRATION",
		"DISABLE_REGISTRATION",
		"FILES_MAX_UPLOAD_BYTES",
		"FILES_MAX_UPLOAD_MB",
		"FILE_STORAGE_DRIVER",
		"GITHUB_APP_ID",
		"GITHUB_APP_NAME",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GITHUB_OAUTH_CLIENT_ID",
		"GITHUB_OAUTH_CLIENT_SECRET",
		"GITHUB_PRIVATE_KEY",
		"GITHUB_PRIVATE_KEY_BASE64",
		"GITHUB_WEBHOOK_SECRET",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS",
		"KANEO_API_KEY",
		"KANEO_API_URL",
		"KANEO_CLIENT_URL",
		"KANEO_CLOUD",
		"KANEO_MCP_CLIENT_ID",
		"LOCAL_UPLOAD_DIR",
		"LOCAL_UPLOAD_SECRET",
		"NODE_ENV",
		"NOTIFICATION_SECRET_ENCRYPTION_KEY",
		"POSTGRES_DB",
		"POSTGRES_HOST",
		"POSTGRES_PASSWORD",
		"POSTGRES_PORT",
		"POSTGRES_USER",
		"REDIS_CLUSTER_NODES",
		"REDIS_PASSWORD",
		"REDIS_SENTINELS",
		"REDIS_SENTINEL_MASTER_NAME",
		"REDIS_SENTINEL_PASSWORD",
		"REDIS_SENTINEL_TLS",
		"REDIS_URL",
		"S3_ACCESS_KEY_ID",
		"S3_BUCKET",
		"S3_ENDPOINT",
		"S3_FORCE_PATH_STYLE",
		"S3_KEY_PREFIX",
		"S3_MAX_IMAGE_UPLOAD_BYTES",
		"S3_PRESIGN_TTL_SECONDS",
		"S3_REGION",
		"S3_SECRET_ACCESS_KEY",
		"SETTINGS_ENCRYPTION_KEY",
		"SMTP_",
		"SMTP_FROM",
		"SMTP_FROM_NAME",
		"SMTP_HOST",
		"SMTP_IGNORE_TLS",
		"SMTP_PASSWORD",
		"SMTP_PORT",
		"SMTP_REQUIRE_TLS",
		"SMTP_SECURE",
		"SMTP_USER",
		"SUPPORT_EMAIL",
		"TURNSTILE_SECRET_KEY",
		"XDG_CONFIG_HOME"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		}
	}
}
