{
  "name": "@kaneo/api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/seed/demo.ts --bundle --platform=node --outdir=dist --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:pg-native",
    "lint": "biome check --write .",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:user-data": "tsx scripts/seed-user-data.ts",
    "db:seed:demo": "tsx src/seed/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@hono/standard-validator": "^0.4.1",
    "@kaneo/email": "workspace:*",
    "@kaneo/permissions": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/webhooks": "^14.2.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@valibot/to-json-schema": "^1.8.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.7.14",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "hono-openapi": "^1.5.0",
    "ioredis": "^5.11.1",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "rrule": "2.8.1",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
